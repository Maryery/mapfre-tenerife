---
import Layout from "../../../layouts/Layout.astro";

const phoneHref = "tel:+34822145513";

const whatsappHref =
  "https://wa.me/34646743707?text=Hello%2C%20I%20would%20like%20information%20about%20car%20insurance.";

const mapsHref =
  "https://www.google.com/maps/search/?api=1&query=Calle+Grande+56+38670+Adeje+Santa+Cruz+de+Tenerife";
---

<link
  rel="icon"
  href="/logos/favicon.png"
  type="image/svg+xml"
/>

<Layout
  title="Car Insurance in Tenerife | Insurance Adeje"
  description="Car insurance in Tenerife and Adeje. We help you find the right level of cover for your vehicle and your needs, with personal service from our office in Calle Grande 56, Adeje."
>

  <main>

    <!-- BACK TO ENGLISH HOME -->

    <div class="backHomeWrapper">
      <a href="/en/" class="backHome">
        ← Back to Insurance Adeje
      </a>
    </div>


    <!-- HERO -->

    <section class="hero">

      <div class="heroContent">

        <p class="eyebrow">
          CAR INSURANCE
        </p>

        <h1>
          Car insurance in Tenerife
        </h1>

        <p class="lead">
          We help you find car insurance suited to your vehicle and your needs,
          with personal service from our office in South Tenerife.
        </p>

        <div class="heroActions">

          <a
            href={phoneHref}
            class="button primary large"
          >
            Call us
          </a>

          <a
            href={whatsappHref}
            class="button secondary large"
          >
            Request a quote on WhatsApp
          </a>

        </div>

      </div>


      <!-- MAR AND ANTONIO -->

      <div class="contactCard">

        <div class="teamImage">

          <img
            src="/images/mar-antonio-seguros-adeje.png"
            alt="Mar and Antonio, personal insurance service in Adeje"
            loading="eager"
          />

        </div>

        <div class="contactCardContent">

          <p class="contactLabel">
            PERSONAL SERVICE
          </p>

          <h3>
            Want to know which option suits you?
          </h3>

          <p class="contactText">
            Tell us about your car and the type of protection you are looking for.
            We will help you explore the available options.
          </p>

          <a
            href={whatsappHref}
            class="button primary contactButton"
          >
            Talk to us
          </a>

          <p class="teamNames">
            Mar and Antonio · Insurance Adeje
          </p>

        </div>

      </div>

    </section>


    <!-- TYPES OF CAR INSURANCE -->

    <section class="products">

      <div class="sectionHeader">

        <p class="eyebrow">
          COVER OPTIONS
        </p>

        <h2>
          Types of car insurance and which one suits your needs
        </h2>

        <p class="sectionText">
          Choosing the right car insurance depends on your vehicle,
          how you use it and the level of protection you are looking for.
          These are some of the most common options.
        </p>

      </div>


      <div class="productGrid">

        <article class="productCard pinkCard">

          <span class="productNumber">
            01
          </span>

          <h3>
            Third-party insurance
          </h3>

          <p>
            This is the basic level of insurance required by law.
            It includes third-party liability for damage caused to others
            and may include additional cover depending on the policy selected.
          </p>

        </article>


        <article class="productCard greenCard">

          <span class="productNumber">
            02
          </span>

          <h3>
            Extended third-party insurance
          </h3>

          <p>
            This extends third-party protection with additional cover
            that may include windows, theft or fire, depending on the
            policy selected.
          </p>

        </article>


        <article class="productCard">

          <span class="productNumber">
            03
          </span>

          <h3>
            Comprehensive insurance
          </h3>

          <p>
            Provides broader protection and may include damage to your
            own vehicle, according to the terms and conditions of the policy.
          </p>

        </article>


        <article class="productCard greyCard">

          <span class="productNumber">
            04
          </span>

          <h3>
            Comprehensive insurance with excess
          </h3>

          <p>
            Provides broad protection while you agree to pay a specified
            amount towards the cost of certain claims.
          </p>

        </article>

      </div>

    </section>


    <!-- OTHER VEHICLES -->

    <section class="specialSection">

      <div class="sectionHeader">

        <p class="eyebrow">
          OTHER CAR INSURANCE
        </p>

        <h2>
          Insurance solutions for other types of vehicles
        </h2>

        <p class="sectionText">
          We can also help if you drive an electric, hybrid or classic car.
        </p>

      </div>


      <div class="specialGrid">

        <article class="specialCard electricCard">

          <div class="specialTag">

            <span class="greenDot"></span>

            ELECTRIC & HYBRID CARS

          </div>

          <h3>
            Insurance for electric and hybrid cars
          </h3>

          <p>
            If you drive an electric or hybrid vehicle, we can help you
            explore the available options and the cover that best suits
            your needs.
          </p>

          <a
            href={whatsappHref}
            class="productLink"
          >
            More information →
          </a>

        </article>


        <article class="specialCard classicCard">

          <div class="specialTag">

            <span class="pinkDot"></span>

            CLASSIC CARS

          </div>

          <h3>
            Insurance for classic cars
          </h3>

          <p>
            If you own a classic car, we can help you explore the available
            options taking into account its characteristics, age and use.
          </p>

          <a
            href={whatsappHref}
            class="productLink"
          >
            More information →
          </a>

        </article>

      </div>

    </section>


    <!-- VISIT US -->

    <section class="visitSection">

      <div class="visitContent">

        <div class="visitText">

          <p class="eyebrow">
            VISIT US
          </p>

          <h2>
            Prefer to talk in person?
          </h2>

          <p class="visitDescription">
            Visit us at our office in Adeje. Tell us about your car and
            the type of protection you are looking for, and we will help
            you explore the available options.
          </p>

          <div class="visitActions">

            <a
              href={mapsHref}
              target="_blank"
              rel="noopener noreferrer"
              class="button primary large"
            >
              Get directions
            </a>

            <a
              href={phoneHref}
              class="button secondary large"
            >
              Call us
            </a>

          </div>

        </div>


        <!-- OFFICE DETAILS -->

        <div class="officeCard">

          <div class="officeTop">

            <div class="officeIcon">

              <svg
                viewBox="0 0 24 24"
                width="28"
                height="28"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                <circle cx="12" cy="10" r="2.5"></circle>
              </svg>

            </div>

            <div>

              <span class="officeLabel">
                OUR OFFICE
              </span>

              <h3>
                Insurance Adeje
              </h3>

            </div>

          </div>


          <div class="officeDetails">

            <p>
              <strong>
                Address
              </strong>

              Calle Grande, 56<br />
              38670 Adeje<br />
              Santa Cruz de Tenerife
            </p>


            <p>
              <strong>
                Opening hours
              </strong>

              Monday to Thursday · 9:00 – 17:00<br />
              Friday · 9:00 – 15:00
            </p>


            <p>
              <strong>
                Phone
              </strong>

              <a href={phoneHref}>
                822 145 513
              </a>
            </p>

          </div>


          <a
            href={mapsHref}
            target="_blank"
            rel="noopener noreferrer"
            class="officeMapLink"
          >
            View location on Google Maps →
          </a>

        </div>

      </div>

    </section>


    <!-- FOOTER -->

    <footer class="footer">

      <div class="footerContent">

        <p>
          © 2026 Insurance Adeje · Calle Grande 56. All rights reserved.
        </p>

        <div class="footerSocial">

          <a
            href="https://www.facebook.com/people/Mapfre-Adeje-Calle-Grande/61574568760634/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Facebook
          </a>

          <a
            href="https://www.instagram.com/mapfreadejeseguros"
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>

        </div>

      </div>

    </footer>

  </main>

</Layout>


<style>

  :global(:root) {
    --red: #e30613;
    --red-dark: #c90012;
    --muted: #65707c;
    --bg: #f5f5f5;
    --white: #ffffff;
    --line: #e9e9e9;
    --black: #1f2937;
    --text: #4b5563;
    --heading: #202938;
    --pink: #fff0f2;
    --pink-border: #f7dfe3;
    --green: #a8c900;
    --green-soft: #f3f7df;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--black);
  }

  :global(a) {
    text-decoration: none;
  }


  /* BACK HOME */

  .backHomeWrapper {
    padding: 24px clamp(32px, 7vw, 96px) 0;
    background: var(--bg);
  }

  .backHome {
    display: inline-flex;
    align-items: center;
    color: var(--red);
    font-size: 14px;
    font-weight: 900;
    transition: color .2s ease, transform .2s ease;
  }

  .backHome:hover {
    color: var(--red-dark);
    transform: translateX(-3px);
  }


  /* BUTTONS */

  .button {
    min-height: 46px;
    padding: 0 22px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 14px;
    transition: all .2s ease;
  }

  .button.large {
    min-height: 58px;
    padding: 0 30px;
    font-size: 15px;
  }

  .primary {
    background: var(--red);
    color: white;
    border: 2px solid var(--red);
    box-shadow: 0 14px 30px rgba(227, 6, 19, .2);
  }

  .primary:hover {
    background: var(--red-dark);
    border-color: var(--red-dark);
  }

  .secondary {
    background: white;
    color: var(--red);
    border: 2px solid var(--red);
  }

  .secondary:hover {
    background: #fff5f5;
  }


  /* HERO */

  .hero {
    min-height: auto;
    padding: 38px clamp(32px, 7vw, 96px) 90px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, .55fr);
    gap: clamp(45px, 6vw, 90px);
    align-items: center;
  }

  .heroContent {
    max-width: none;
    width: 100%;
  }

  .eyebrow {
    margin: 0 0 16px;
    color: var(--red);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .hero h1 {
    margin: 0;
    max-width: 900px;
    font-size: clamp(48px, 6vw, 80px);
    line-height: .95;
    letter-spacing: -.055em;
    color: var(--heading);
  }

  h2 {
    margin: 0;
    font-size: clamp(36px, 5vw, 62px);
    line-height: 1;
    letter-spacing: -.045em;
    color: var(--heading);
  }

  .lead {
    margin: 28px 0 0;
    max-width: 680px;
    color: var(--muted);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.6;
  }

  .heroActions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 36px;
  }


  /* CONTACT CARD */

  .contactCard {
    overflow: hidden;
    background: var(--pink);
    border: 1px solid var(--pink-border);
    border-radius: 26px;
    box-shadow: 0 18px 40px rgba(15, 23, 42, .07);
  }

  .teamImage {
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #f7f7f7;
  }

  .teamImage img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: none;
  }

  .contactCardContent {
    padding: 28px 32px 30px;
  }

  .contactLabel {
    margin: 0 0 13px;
    color: var(--red);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .08em;
  }

  .contactCard h3 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 28px;
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -.03em;
  }

  .contactText {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
  }

  .contactButton {
    width: 100%;
    margin-top: 22px;
  }

  .teamNames {
    margin: 15px 0 0;
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
    text-align: center;
  }


  /* PRODUCTS */

  .products {
    padding: 70px clamp(24px, 6vw, 88px) 80px;
    background: #f4f5f7;
  }

  .sectionHeader {
    max-width: 880px;
  }

  .sectionText {
    margin: 26px 0 0;
    max-width: 760px;
    color: var(--muted);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.6;
  }

  .productGrid {
    margin-top: 42px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
  }

  .productCard {
    min-height: 280px;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 26px;
    padding: 34px 28px;
    display: flex;
    flex-direction: column;
    transition:
      transform .25s ease,
      border-color .25s ease,
      box-shadow .25s ease;
  }

  .productCard:hover {
    transform: translateY(-4px);
    border-color: var(--red);
    box-shadow: 0 18px 40px rgba(15, 23, 42, .08);
  }

  .pinkCard {
    background: var(--pink);
    border-color: var(--pink-border);
  }

  .greenCard {
    background: var(--green-soft);
    border-color: #e4ebc1;
  }

  .greyCard {
    background: #eef0f2;
  }

  .productNumber {
    margin-bottom: 24px;
    color: var(--red);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .08em;
  }

  .greenCard .productNumber {
    color: #7c9500;
  }

  .productCard h3 {
    margin: 0 0 14px;
    font-size: 24px;
    font-weight: 900;
    color: var(--heading);
  }

  .productCard p {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.5;
    font-weight: 600;
  }


  /* OTHER VEHICLES */

  .specialSection {
    padding: 80px clamp(24px, 6vw, 88px);
    background: white;
  }

  .specialGrid {
    margin-top: 42px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .specialCard {
    min-height: 290px;
    border-radius: 26px;
    padding: 34px 28px;
    display: flex;
    flex-direction: column;
  }

  .electricCard {
    background: var(--green-soft);
    border: 1px solid #e4ebc1;
  }

  .classicCard {
    background: var(--pink);
    border: 1px solid var(--pink-border);
  }

  .specialTag {
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .08em;
  }

  .greenDot,
  .pinkDot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: block;
  }

  .greenDot {
    background: var(--green);
  }

  .pinkDot {
    background: #ed9aaa;
  }

  .specialCard h3 {
    margin: 0 0 14px;
    font-size: 24px;
    font-weight: 900;
    color: var(--heading);
  }

  .specialCard p {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.5;
    font-weight: 600;
  }

  .productLink {
    display: inline-block;
    margin-top: auto;
    padding-top: 24px;
    color: var(--red);
    font-weight: 900;
    font-size: 17px;
    transition: all .2s ease;
  }

  .productLink:hover {
    color: var(--red-dark);
    transform: translateX(4px);
  }


  /* VISIT */

  .visitSection {
    padding: 90px clamp(24px, 6vw, 88px);
    background:
      linear-gradient(
        110deg,
        #fff0f2 0%,
        #fff7f8 58%,
        #f3f7df 100%
      );
  }

  .visitContent {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, .7fr);
    gap: clamp(45px, 7vw, 90px);
    align-items: center;
  }

  .visitText h2 {
    max-width: 650px;
  }

  .visitDescription {
    margin: 28px 0 0;
    max-width: 620px;
    color: var(--muted);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.6;
  }

  .visitActions {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }


  /* OFFICE CARD */

  .officeCard {
    background: white;
    border: 1px solid rgba(32, 41, 56, .08);
    border-radius: 26px;
    padding: 32px;
    box-shadow: 0 18px 45px rgba(15, 23, 42, .08);
  }

  .officeTop {
    display: flex;
    align-items: center;
    gap: 17px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }

  .officeIcon {
    width: 58px;
    height: 58px;
    flex: 0 0 58px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--green-soft);
    color: #819b00;
  }

  .officeLabel {
    display: block;
    margin-bottom: 5px;
    color: var(--red);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .08em;
  }

  .officeTop h3 {
    margin: 0;
    color: var(--heading);
    font-size: 25px;
    font-weight: 900;
  }

  .officeDetails {
    padding-top: 6px;
  }

  .officeDetails p {
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
    font-weight: 600;
  }

  .officeDetails strong {
    display: block;
    margin-bottom: 4px;
    color: var(--heading);
    font-size: 14px;
    font-weight: 900;
  }

  .officeDetails a {
    color: var(--red);
    font-weight: 900;
  }

  .officeMapLink {
    display: inline-block;
    margin-top: 26px;
    color: var(--red);
    font-size: 16px;
    font-weight: 900;
    transition: all .2s ease;
  }

  .officeMapLink:hover {
    color: var(--red-dark);
    transform: translateX(4px);
  }


  /* FOOTER */

  .footer {
    background: var(--red);
    color: white;
    padding: 30px clamp(24px, 6vw, 88px);
  }

  .footerContent {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .footer p {
    margin: 0;
    color: white;
    font-size: 14px;
    line-height: 1.5;
  }

  .footerSocial {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .footerSocial a {
    color: white;
    font-size: 16px;
    font-weight: 900;
    transition: opacity .2s ease;
  }

  .footerSocial a:hover {
    opacity: .75;
  }


  /* RESPONSIVE */

  @media (max-width: 1400px) {

    .hero h1 {
      max-width: 780px;
      font-size: clamp(46px, 5.5vw, 72px);
    }

    .heroContent {
      max-width: 820px;
    }

  }


  @media (min-width: 981px) and (max-width: 1500px) {

    .hero h1 {
      max-width: 760px;
      font-size: clamp(46px, 5vw, 68px);
    }

    .lead {
      max-width: 620px;
    }

    .hero {
      padding-left: clamp(32px, 6vw, 76px);
      padding-right: clamp(32px, 6vw, 76px);
    }

  }


  @media (min-width: 1200px) and (max-width: 1600px) {

    .hero h1 {
      max-width: 640px;
      font-size: clamp(44px, 4.2vw, 62px);
    }

    .lead {
      max-width: 560px;
    }

    .heroActions {
      max-width: 640px;
    }

  }


  @media (max-width: 1100px) {

    .productGrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }


  @media (max-width: 980px) {

    .hero {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .contactCard {
      width: 100%;
      max-width: 650px;
    }

    .teamImage {
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 2;
    }

    .teamImage img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transform: none;
    }

    .visitContent {
      grid-template-columns: 1fr;
    }

    .officeCard {
      max-width: 620px;
    }

  }


  @media (max-width: 620px) {

    .backHomeWrapper {
      padding: 18px 22px 0;
    }

    .hero {
      padding-top: 24px;
      padding-bottom: 40px;
      gap: 42px;
    }

    .heroActions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .button {
      width: 100%;
    }

    .hero h1 {
      letter-spacing: -.04em;
    }

    .lead {
      margin-top: 8px;
    }

    .productGrid,
    .specialGrid {
      grid-template-columns: 1fr;
    }

    .products,
    .specialSection,
    .visitSection {
      padding-left: 22px;
      padding-right: 22px;
    }

    .contactCardContent,
    .officeCard {
      padding: 25px 22px;
    }

    .teamImage {
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 2;
    }

    .teamImage img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transform: none;
    }

    .visitActions {
      flex-direction: column;
    }

    .footer {
      padding: 28px 22px;
    }

