---
import Layout from "../../../layouts/Layout.astro";

const phoneHref = "tel:+34822145513";

const whatsappHref =
  "https://wa.me/34646743707?text=Bonjour%2C%20je%20souhaiterais%20obtenir%20des%20informations%20sur%20l%27assurance%20auto";

const mapsHref =
  "https://www.google.com/maps/search/?api=1&query=Calle+Grande+56+38670+Adeje+Santa+Cruz+de+Tenerife";
---

<link rel="icon" href="/logos/favicon.png" type="image/png" />

<Layout
  title="Assurance auto à Adeje | Seguros Adeje"
  description="Assurance auto à Adeje, dans le sud de Tenerife. Conseils personnalisés sur les garanties disponibles dans notre agence, Calle Grande 56 à Adeje."
>
  <main>
    <!-- ======================================================
         BACK TO HOMEPAGE
    ======================================================= -->

    <div class="backHomeWrapper">
      <a href="/fr/" class="backHome">
        ← Retour
      </a>
    </div>

    <!-- ======================================================
         HERO
    ======================================================= -->

    <section class="hero">
      <div class="heroContent">
        <p class="eyebrow">ASSURANCE AUTO</p>

        <h1>Assurance auto à Adeje</h1>

        <p class="lead">
          Nous vous aidons à trouver une assurance adaptée à votre voiture et à
          vos besoins, avec des conseils personnalisés depuis notre agence dans
          le sud de Tenerife.
        </p>

        <div class="heroActions">
          <a href={phoneHref} class="button primary large">
            Appelez-nous
          </a>

          <a href={whatsappHref} class="button secondary large">
            Demander un devis sur WhatsApp
          </a>
        </div>
      </div>

      <!-- ADVICE CARD -->

      <div class="contactCard">
        <div class="teamImage">
          <img
            src="/images/seguro-coche-adeje-tenerife-sur.png"
            alt="Voiture à Adeje, dans le sud de Tenerife"
            loading="eager"
            width="1200"
            height="800"
          />
        </div>

        <div class="contactCardContent">
          <p class="contactLabel">ACCOMPAGNEMENT PERSONNALISÉ</p>

          <h3>Agent exclusif MAPFRE</h3>

          <p class="contactText">
            Parlez-nous de votre voiture et du niveau de protection souhaité.
            Nous vous aidons à étudier les formules et garanties disponibles.
          </p>
        </div>
      </div>
    </section>

    <!-- ======================================================
         FORMULES D’ASSURANCE
    ======================================================= -->

    <section class="products">
      <div class="sectionHeader">
        <p class="eyebrow">FORMULES D’ASSURANCE</p>

        <h2>Les différentes formules d’assurance auto : laquelle choisir ?</h2>

        <p class="sectionText">
          Le choix de votre assurance auto dépend du véhicule, de son
          utilisation et du niveau de protection recherché. Voici quelques-unes
          des formules les plus courantes.
        </p>
      </div>

      <div class="productGrid">
        <article class="productCard pinkCard">
          <span class="productNumber">01</span>

          <h3>Assurance au tiers</h3>

          <p>
            C’est la couverture de base obligatoire. Elle comprend la
            responsabilité civile pour les dommages causés aux tiers et peut
            inclure d’autres garanties selon la formule souscrite.
          </p>
        </article>

        <article class="productCard greenCard">
          <span class="productNumber">02</span>

          <h3>Assurance au tiers étendue</h3>

          <p>
            Elle complète l’assurance au tiers avec des garanties pouvant
            inclure le bris de glace, le vol ou l’incendie, selon la formule
            choisie.
          </p>
        </article>

        <article class="productCard">
          <span class="productNumber">03</span>

          <h3>Assurance tous risques</h3>

          <p>
            Elle offre une protection plus étendue et peut couvrir les dommages
            subis par votre propre véhicule, conformément aux conditions du
            contrat.
          </p>
        </article>

        <article class="productCard greyCard">
          <span class="productNumber">04</span>

          <h3>Assurance tous risques avec franchise</h3>

          <p>
            Elle permet de bénéficier d’une protection étendue tout en prenant
            en charge une part définie des frais lors de certains sinistres.
          </p>
        </article>
      </div>
    </section>

    <!-- ======================================================
         OTHER VEHICLES
    ======================================================= -->

    <section class="specialSection">
      <div class="sectionHeader">
        <p class="eyebrow">AUTRES VÉHICULES</p>

        <h2>Des solutions pour d’autres types de véhicules</h2>

        <p class="sectionText">
          Nous pouvons également vous accompagner si vous conduisez une voiture
          électrique, hybride ou de collection.
        </p>
      </div>

      <div class="specialGrid">
        <article class="specialCard electricCard">
          <div class="specialTag">
            <span class="greenDot"></span>
            VOITURES ÉLECTRIQUES ET HYBRIDES
          </div>

          <h3>Assurance pour voitures électriques et hybrides</h3>

          <p>
            Si vous conduisez une voiture électrique ou hybride, nous vous
            aidons à étudier les solutions disponibles et les garanties adaptées
            à vos besoins.
          </p>

          <a href={whatsappHref} class="productLink">
            En savoir plus →
          </a>
        </article>

        <article class="specialCard classicCard">
          <div class="specialTag">
            <span class="pinkDot"></span>
            VOITURES DE COLLECTION
          </div>

          <h3>Assurance pour voitures de collection</h3>

          <p>
            Si vous possédez une voiture de collection, nous pouvons étudier les
            options disponibles en tenant compte de ses caractéristiques, de son
            ancienneté et de son utilisation.
          </p>

          <a href={whatsappHref} class="productLink">
            En savoir plus →
          </a>
        </article>
      </div>
    </section>

    <!-- ======================================================
         RENDEZ-NOUS VISITE
    ======================================================= -->

    <section class="visitSection">
      <div class="visitContent">
        <div class="visitText">
          <p class="eyebrow">RENDEZ-NOUS VISITE</p>

          <h2>Vous préférez en parler en personne ?</h2>

          <p class="visitDescription">
            Rendez-vous dans notre agence. Parlez-nous de votre voiture et de la
            protection souhaitée : nous vous aiderons à examiner les options
            disponibles.
          </p>

          <div class="visitActions">
            <a
              href={mapsHref}
              target="_blank"
              rel="noopener noreferrer"
              class="button primary large"
            >
              Itinéraire
            </a>

            <a href={phoneHref} class="button secondary large">
              Appelez-nous
            </a>
          </div>
        </div>

        <!-- ==================================================
             OFFICE DETAILS
        =================================================== -->

        <div class="officeCard">
          <div class="officeTop">
            <div class="officeIcon">
              <svg
                viewBox="0 0 24 24"
                width="28"
                height="28"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                <circle cx="12" cy="10" r="2.5"></circle>
              </svg>
            </div>
            <div>
              <span class="officeLabel">NOTRE AGENCE</span>
              <h3>Seguros Adeje</h3>
              <p class="officeMapfre">Agent exclusif MAPFRE</p>
            </div>
          </div>

          <div class="officeDetails">
            <p>
              <strong>Adresse</strong>
              Calle Grande, 56
              <br />
              38670 Adeje
              <br />
              Santa Cruz de Tenerife
            </p>
            <p>
              <strong>Horaires d’ouverture</strong>
              Du lundi au jeudi · 9 h – 17 h
              <br />
              Vendredi · 9 h – 15 h
            </p>

            <p>
              <strong>Téléphones</strong>
              Agence : <a href="tel:+34822145513">822 145 513</a>
              <br />
              Antonio · Responsable :<a href="tel:+34646743707">646 743 707</a>
              <br />
              Mar · Conseillère commerciale :
              <a href="tel:+34671492025">671 492 025</a>
            </p>
          </div>

          <a
            href={mapsHref}
            target="_blank"
            rel="noopener noreferrer"
            class="officeMapLink"
          >
            Voir notre emplacement sur Google Maps →
          </a>
        </div>
      </div>
    </section>

    <!-- ======================================================
         FOOTER
    ======================================================= -->

    <footer class="footer">
      <div class="footerContent">
        <p>© 2026 Seguros Adeje · Calle Grande 56. Tous droits réservés.</p>

        <div class="footerSocial">
          <a
            href="https://www.facebook.com/people/Mapfre-Adeje-Calle-Grande/61574568760634/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Seguros Adeje sur Facebook"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12Z" />
            </svg>
            <span>Facebook</span>
          </a>

          <a
            href="https://www.instagram.com/mapfreadejeseguros"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Seguros Adeje sur Instagram"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              focusable="false"
            >
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle
                cx="17.5"
                cy="6.5"
                r="1"
                fill="currentColor"
                stroke="none"
              />
            </svg>
            <span>Instagram</span>
          </a>
        </div>
      </div>

      <p class="footerDisclaimer">
        Site à caractère informatif. La souscription des contrats d’assurance
        s’effectue par les canaux agréés de l’assureur.
      </p>
    </footer>
  </main>
</Layout>

<style>
  /* =========================================================
                   COLORES
                ========================================================= */

  :global(:root) {
    --red: #e30613;
    --red-dark: #c90012;
    --muted: #65707c;
    --bg: #f5f5f5;
    --white: #ffffff;
    --line: #e9e9e9;
    --black: #1f2937;
    --text: #4b5563;
    --heading: #202938;

    --pink: #fff0f2;
    --pink-border: #f7dfe3;

    --green: #a8c900;
    --green-soft: #f3f7df;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;

    font-family: Arial, Helvetica, sans-serif;

    background: var(--bg);

    color: var(--black);
  }

  :global(a) {
    text-decoration: none;
  }

  /* =========================================================
                   VOLVER A LA PRINCIPAL
                ========================================================= */

  .backHomeWrapper {
    padding: 24px clamp(32px, 7vw, 96px) 0;

    background: var(--bg);
  }

  .backHome {
    display: inline-flex;

    align-items: center;

    color: var(--red);

    font-size: 14px;

    font-weight: 900;

    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .backHome:hover {
    color: var(--red-dark);

    transform: translateX(-3px);
  }

  /* =========================================================
                   BOTONES
                ========================================================= */

  .button {
    min-height: 46px;

    padding: 0 22px;

    border-radius: 999px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    font-weight: 900;

    font-size: 14px;

    transition: all 0.2s ease;
  }

  .button.large {
    min-height: 58px;

    padding: 0 30px;

    font-size: 15px;
  }

  .primary {
    background: var(--red);

    color: white;

    border: 2px solid var(--red);

    box-shadow: 0 14px 30px rgba(227, 6, 19, 0.2);
  }

  .primary:hover {
    background: var(--red-dark);

    border-color: var(--red-dark);
  }

  .secondary {
    background: white;

    color: var(--red);

    border: 2px solid var(--red);
  }

  .secondary:hover {
    background: #fff5f5;
  }

  /* =========================================================
                   HERO
                ========================================================= */

  .hero {
    min-height: auto;
    padding: 28px clamp(32px, 7vw, 96px) 20px;
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(360px, 0.55fr);
    gap: clamp(45px, 6vw, 90px);
    align-items: center;
  }

  .heroContent {
    max-width: none;

    width: 100%;
  }

  .eyebrow {
    margin: 0 0 16px;

    color: var(--red);

    font-size: 13px;

    font-weight: 900;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .hero h1 {
    margin: 0;

    max-width: 900px;

    font-size: clamp(48px, 6vw, 80px);

    line-height: 0.95;

    letter-spacing: -0.055em;

    color: var(--heading);
  }

  h2 {
    margin: 0;

    font-size: clamp(36px, 5vw, 62px);

    line-height: 1;

    letter-spacing: -0.045em;

    color: var(--heading);
  }

  .lead {
    margin: 28px 0 0;

    max-width: 680px;

    color: var(--muted);

    font-size: clamp(18px, 2vw, 22px);

    line-height: 1.6;
  }

  .heroActions {
    display: flex;

    gap: 12px;

    align-items: center;

    flex-wrap: wrap;

    margin-top: 28px;
  }

  /* =========================================================
                   TARJETA MAR Y ANTONIO
                ========================================================= */

  .contactCard {
    overflow: hidden;

    background: var(--pink);

    border: 1px solid var(--pink-border);

    border-radius: 26px;

    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.07);
  }

  .teamImage {
    width: 100%;

    aspect-ratio: 3 / 2;

    overflow: hidden;

    background: #f7f7f7;
  }

  .teamImage img {
    display: block;

    width: 100%;

    height: 100%;

    object-fit: cover;

    object-position: center;

    transform: none;
  }

  .contactCardContent {
    padding: 28px 32px 30px;
  }

  .contactLabel {
    margin: 0 0 13px;

    color: var(--red);

    font-size: 12px;

    font-weight: 900;

    letter-spacing: 0.08em;
  }

  .contactCard h3 {
    margin: 0 0 14px;

    color: var(--heading);

    font-family: inherit;

    font-size: clamp(20px, 1.7vw, 24px);

    font-weight: 700;

    line-height: 1.2;

    letter-spacing: -0.025em;
  }

  @media (min-width: 768px) {
    .contactCard h3 {
      white-space: nowrap;
    }
  }

  .contactText {
    margin: 0;

    color: var(--muted);

    font-size: 16px;

    line-height: 1.55;
  }

  .contactButton {
    width: 100%;

    margin-top: 22px;
  }

  .teamNames {
    margin: 15px 0 0;

    color: var(--muted);

    font-size: 13px;

    font-weight: 700;

    text-align: center;
  }

  /* =========================================================
                   MODALIDADES
                ========================================================= */

  .products {
    padding: 36px clamp(24px, 6vw, 88px) 60px;

    background: #f4f5f7;
  }

  .sectionHeader {
    max-width: 880px;
  }

  .sectionText {
    margin: 26px 0 0;

    max-width: 760px;

    color: var(--muted);

    font-size: clamp(18px, 2vw, 22px);

    line-height: 1.6;
  }

  .productGrid {
    margin-top: 32px;

    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 22px;
  }

  .productCard {
    min-height: 260px;

    background: white;

    border: 1px solid #e5e7eb;

    border-radius: 26px;

    padding: 30px 26px;

    display: flex;

    flex-direction: column;

    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .productCard:hover {
    transform: translateY(-4px);

    border-color: var(--red);

    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
  }

  .pinkCard {
    background: var(--pink);

    border-color: var(--pink-border);
  }

  .greenCard {
    background: var(--green-soft);

    border-color: #e4ebc1;
  }

  .greyCard {
    background: #eef0f2;
  }

  .productNumber {
    margin-bottom: 24px;

    color: var(--red);

    font-size: 13px;

    font-weight: 900;

    letter-spacing: 0.08em;
  }

  .greenCard .productNumber {
    color: #7c9500;
  }

  .productCard h3 {
    margin: 0 0 14px;

    font-size: 24px;

    font-weight: 900;

    color: var(--heading);
  }

  .productCard p {
    margin: 0;

    color: var(--muted);

    font-size: 16px;

    line-height: 1.5;

    font-weight: 600;
  }

  /* =========================================================
                   OTROS VEHÍCULOS
                ========================================================= */

  .specialSection {
    padding: 60px clamp(24px, 6vw, 88px);

    background: white;
  }

  .specialGrid {
    margin-top: 32px;

    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 22px;
  }

  .specialCard {
    min-height: 260px;

    border-radius: 26px;

    padding: 30px 26px;

    display: flex;

    flex-direction: column;
  }

  .electricCard {
    background: var(--green-soft);

    border: 1px solid #e4ebc1;
  }

  .classicCard {
    background: var(--pink);

    border: 1px solid var(--pink-border);
  }

  .specialTag {
    margin-bottom: 24px;

    display: flex;

    align-items: center;

    gap: 9px;

    color: var(--muted);

    font-size: 12px;

    font-weight: 900;

    letter-spacing: 0.08em;
  }

  .greenDot,
  .pinkDot {
    width: 10px;

    height: 10px;

    border-radius: 50%;

    display: block;
  }

  .greenDot {
    background: var(--green);
  }

  .pinkDot {
    background: #ed9aaa;
  }

  .specialCard h3 {
    margin: 0 0 14px;

    font-size: 24px;

    font-weight: 900;

    color: var(--heading);
  }

  .specialCard p {
    margin: 0;

    color: var(--muted);

    font-size: 16px;

    line-height: 1.5;

    font-weight: 600;
  }

  .productLink {
    display: inline-block;

    margin-top: auto;

    padding-top: 24px;

    color: var(--red);

    font-weight: 900;

    font-size: 17px;

    transition: all 0.2s ease;
  }

  .productLink:hover {
    color: var(--red-dark);

    transform: translateX(4px);
  }

  /* =========================================================
                   VEN A VERNOS
                ========================================================= */

  .visitSection {
    padding: 60px clamp(24px, 6vw, 88px);

    background: linear-gradient(110deg, #fff0f2 0%, #fff7f8 58%, #f3f7df 100%);
  }

  .visitContent {
    max-width: 1100px;

    margin: 0 auto;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(340px, 0.7fr);

    gap: clamp(45px, 7vw, 90px);

    align-items: center;
  }

  .visitText h2 {
    max-width: 650px;
  }

  .visitDescription {
    margin: 28px 0 0;

    max-width: 620px;

    color: var(--muted);

    font-size: clamp(18px, 2vw, 22px);

    line-height: 1.6;
  }

  .visitActions {
    margin-top: 34px;

    display: flex;

    flex-wrap: wrap;

    gap: 12px;
  }

  /* =========================================================
                   TARJETA OFICINA
                ========================================================= */

  .officeCard {
    background: white;

    border: 1px solid rgba(32, 41, 56, 0.08);

    border-radius: 26px;

    padding: 32px;

    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
  }

  .officeTop {
    display: flex;

    align-items: center;

    gap: 17px;

    padding-bottom: 24px;

    border-bottom: 1px solid var(--line);
  }

  .officeIcon {
    width: 58px;

    height: 58px;

    flex: 0 0 58px;

    border-radius: 50%;

    display: flex;

    align-items: center;

    justify-content: center;

    background: var(--green-soft);

    color: #819b00;
  }

  .officeLabel {
    display: block;

    margin-bottom: 5px;

    color: var(--red);

    font-size: 11px;

    font-weight: 900;

    letter-spacing: 0.08em;
  }

  .officeTop h3 {
    margin: 0;

    color: var(--heading);

    font-size: 25px;

    font-weight: 900;
  }

  .officeDetails {
    padding-top: 6px;
  }

  .officeDetails p {
    margin: 20px 0 0;

    color: var(--muted);

    font-size: 15px;

    line-height: 1.55;

    font-weight: 600;
  }

  .officeDetails strong {
    display: block;

    margin-bottom: 4px;

    color: var(--heading);

    font-size: 14px;

    font-weight: 900;
  }

  .officeDetails a {
    color: var(--red);

    font-weight: 900;
  }

  .officeMapLink {
    display: inline-block;

    margin-top: 26px;

    color: var(--red);

    font-size: 16px;

    font-weight: 900;

    transition: all 0.2s ease;
  }

  .officeMapLink:hover {
    color: var(--red-dark);

    transform: translateX(4px);
  }

  .officeMapfre {
    margin: 6px 0 0;
    color: var(--muted);
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }

  /* =========================================================
                   FOOTER
                ========================================================= */

  .footer {
    background: var(--red);
    color: #fff;
    padding: 30px 24px;
  }

  .footerContent {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .footer p {
    margin: 0;
    color: #fff;
    font-size: 14px;
    line-height: 1.5;
  }

  .footerSocial {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .footerSocial a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .footerSocial a:hover {
    opacity: 0.75;
  }

