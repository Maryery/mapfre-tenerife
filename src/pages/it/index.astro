---
const phone = "+34 822 145 513";

const phoneHref = "tel:+34822145513";

const whatsappHref =
  "https://wa.me/34646743707?text=Buongiorno%2C%20vorrei%20informazioni%20sulle%20assicurazioni%20MAPFRE.";

const products = [
  {
    title: "Auto",
    text: "Protezione per il tuo veicolo.",
    icon: "/icons/car.svg",
    href: "/it/assicurazione-auto-adeje/",
    linkText: "Scopri l’assicurazione auto →",
    internal: true,
  },

  {
    title: "Casa",
    text: "La tua casa sempre protetta.",
    icon: "/icons/home.svg",
  },

  {
    title: "Salute",
    text: "Accesso all’assistenza sanitaria privata.",
    icon: "/icons/health.svg",
  },

  {
    title: "Vita",
    text: "Serenità per la tua famiglia.",
    icon: "/icons/heart.svg",
  },

  {
    title: "Risparmio e investimenti",
    text: "Soluzioni per il tuo futuro.",
    icon: "/icons/chart.svg",
  },

  {
    title: "Imbarcazioni",
    text: "Naviga in tutta tranquillità.",
    icon: "/icons/boat.svg",
  },

  {
    title: "Imprese",
    text: "Assicurazioni per imprese e lavoratori autonomi.",
    icon: "/icons/building.svg",
  },

  {
    title: "Assicurazione funeraria",
    text: "Un sostegno concreto per la tua famiglia.",
    icon: "/icons/shield.svg",
  },
];

const languages = [
  { flag: "/flags/gb.svg", label: "English", href: "/en/" },
  { flag: "/flags/de.svg", label: "Deutsch", href: "/de/" },
  { flag: "/flags/it.svg", label: "Italiano", href: "/it/" },
  { flag: "/flags/fr.svg", label: "Français", href: "/fr/" },
];
---

<html lang="it">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" href="/logos/favicon.png" type="image/png" />

    <title>
    Assicurazioni ad Adeje | Consulenza personalizzata a Tenerife
  </title>

    <meta
      name="description"
      content="Consulenza assicurativa ad Adeje, Tenerife. Soluzioni per privati, famiglie, lavoratori autonomi e imprese."
    />

    <!-- Google Analytics -->

    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-3SJ9D7S4GB"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("js", new Date());

      gtag("config", "G-3SJ9D7S4GB");
    </script>
  </head>

  <body>
    <!-- ======================================================
       HEADER
  ======================================================= -->

    <header class="siteHeader">
      <a href="/" class="brand" aria-label="Seguros Adeje, Calle Grande 56">
        <span class="brandName">Seguros Adeje</span>
        <span class="brandAddress">Calle Grande, 56 · Centro di Adeje</span>
      </a>
      <nav class="languageSwitcher">
        <a href="/">ES</a>

        <a href="/en/">EN</a>

        <a href="/de/">DE</a>

        <a href="/it/" class="active">
          IT
        </a>

        <a href="/fr/">FR</a>
      </nav>
    </header>

    <!-- ======================================================
       MAIN
  ======================================================= -->

    <main>
      <!-- ====================================================
         HERO
    ===================================================== -->

      <section class="hero">
        <div class="heroContent">
          <p class="eyebrow">TENERIFE SUD</p>

          <h1>
            Agenzia assicurativa
            <br />
            ad Adeje
          </h1>

          <p class="lead">
            <strong>La tua agenzia MAPFRE nel sud di Tenerife.</strong>
            <br />
            Assicurazioni auto, casa, salute, vita e funerarie. Piani di
            risparmio. Assicurazioni per le imprese.
            <br />
            Ti offriamo consulenza nella nostra sede in Calle Grande, 56.
          </p>

          <div class="heroActions">
            <a href={whatsappHref} class="button primary large">
              Richiedi un preventivo su WhatsApp
            </a>

            <a href={phoneHref} class="button secondary large">
              Chiama · 822 145 513
            </a>
          </div>
        </div>

        <figure class="heroPortrait">
          <img
            src="/images/mar-y-antonio.png"
            alt="Mar e Antonio, consulenza personalizzata presso Seguros Adeje, agente esclusivo MAPFRE"
            width="1536"
            height="1024"
            loading="eager"
            fetchpriority="high"
          />

          <figcaption>
            <strong>Mar e Antonio</strong>
            <span>Consulenza personalizzata · Agente esclusivo MAPFRE</span>
          </figcaption>
        </figure>
      </section>

      <!-- ====================================================
         OFICINA
    ===================================================== -->

      <!-- ====================================================
     OFICINA Y VENTAJAS
===================================================== -->

      <section class="officeSection">
        <div class="officeLayout">
          <!-- TRES TARJETAS DE VENTAJAS -->
          <div class="trustBar">
            <div class="trustItem">
              <strong>Preventivi</strong>
              <span>Senza impegno</span>
            </div>

            <div class="trustItem">
              <strong>Assistenza personalizzata</strong>
              <span>In spagnolo e inglese</span>
            </div>

            <div class="trustItem">
              <strong>Sempre al tuo fianco</strong>
              <span>Gestione delle polizze e dei sinistri</span>
            </div>
          </div>

          <!-- TARJETA DE OFICINA Y MAPA -->
          <div class="officeCard">
            <div class="officeInfo">
              <strong class="officeTitle">Vieni a trovarci</strong>

              <p class="officeAddress">
                Calle Grande, 56
                <span>Centro di Adeje</span>
              </p>

              <div class="officeHours">
                <strong>Orari di apertura</strong>
                <p>
                  Dal lunedì al giovedì
                  <span>9:00–17:00</span>
                </p>
                <p>
                  Venerdì
                  <span>9:00–15:00</span>
                </p>
              </div>

              <a
                href="https://maps.google.com/?q=Calle+Grande+56+Adeje"
                target="_blank"
                rel="noopener noreferrer"
                class="btnMapa"
              >
                Come raggiungerci
              </a>
            </div>

            <div class="mapa">
              <iframe
                src="https://www.google.com/maps?q=Calle+Grande+56+Adeje&output=embed"
                loading="lazy"
                allowfullscreen
                title="Posizione di Seguros Adeje in Calle Grande 56"
              ></iframe>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================
         PRODUCTOS
    ===================================================== -->

      <section class="products">
        <div class="sectionHeader">
          <p class="eyebrow">Le nostre assicurazioni</p>

          <h2>Che cosa desideri assicurare?</h2>
        </div>

        <div class="productGrid">
          {products.map((product) => (
            <article class="productCard">
              <img src={product.icon} alt={product.title} class="productIcon" />

              <h3>{product.title}</h3>

              <p>{product.text}</p>

              {product.internal ? (
                <a href={product.href} class="productLink">
                  {product.linkText}
                </a>
              ) : (
                <a
                  href={`https://wa.me/34646743707?text=${encodeURIComponent(
                    `Buongiorno, vorrei informazioni sull’assicurazione ${product.title} presso MAPFRE Adeje - Calle Grande 56.`,
                  )}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="productLink"
                >
                  Richiedi un preventivo →
                </a>
              )}
            </article>
          ))}
        </div>
      </section>

      <!-- ====================================================
         IDIOMAS
    ===================================================== -->

      <section class="languages">
        <div class="languageContent">
          <div>
            <p class="eyebrow">SITO WEB IN PIÙ LINGUE</p>
            <h2>Scegli la tua lingua</h2>
          </div>

          <div class="languageGrid">
            {languages.map((language) => (
              <a href={language.href} class="languageCard">
                <span class="languageInfo">
                  <img
                    src={language.flag}
                    alt={language.label}
                    class="languageFlag"
                  />

                  <span>{language.label}</span>
                </span>

                <strong>→</strong>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <!-- ======================================================
       FOOTER
  ======================================================= -->

    <footer class="footer">
      <div class="footerContent">
        <p>
          © 2026 Seguros Adeje · Calle Grande 56. Tutti i diritti riservati.
        </p>

        <div class="footerSocial">
          <a
            href="https://www.facebook.com/people/Mapfre-Adeje-Calle-Grande/61574568760634/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook di Seguros Adeje"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12Z" />
            </svg>
            <span>Facebook</span>
          </a>

          <a
            href="https://www.instagram.com/mapfreadejeseguros"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram di Seguros Adeje"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              focusable="false"
            >
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle
                cx="17.5"
                cy="6.5"
                r="1"
                fill="currentColor"
                stroke="none"
              />
            </svg>
            <span>Instagram</span>
          </a>
        </div>
      </div>

      <p class="footerDisclaimer">
        Sito web informativo. La stipula delle polizze avviene attraverso i
        canali autorizzati dalla compagnia assicurativa.
      </p>
    </footer>
  </body>
</html>

<style>
  /* =========================================================
        											   VARIABLES
        											========================================================= */

  :root {
    --red: #e30613;

    --red-dark: #c90012;

    --muted: #65707c;

    --bg: #f5f5f5;

    --white: #ffffff;

    --line: #e9e9e9;

    --radius-md: 22px;

    --black: #1f2937;

    --text: #4b5563;

    --heading: #202938;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;

    font-family: Arial, Helvetica, sans-serif;

    background: var(--bg);

    color: var(--black);
  }

  a {
    text-decoration: none;
  }

  /* =========================================================
        											   HEADER
        											========================================================= */

  .siteHeader {
    min-height: 96px;
    padding: 18px clamp(24px, 6vw, 88px);
    background: var(--white);
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
    color: var(--heading);
    text-decoration: none;
  }

  .logoFrame {
    display: none;
  }

  .brandName {
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .brandAddress {
    color: var(--muted);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
  }

  .languageSwitcher {
    display: flex;

    gap: 14px;

    margin-left: auto;

    margin-right: 24px;
  }

  .languageSwitcher a {
    color: #374151;

    font-weight: 700;
  }

  .languageSwitcher a.active {
    color: var(--red);
  }

  /* =========================================================
        											   BOTONES
        											========================================================= */

  .headerActions,
  .heroActions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .button {
    min-height: 46px;
    padding: 0 22px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 14px;
    transition: all 0.2s ease;
  }

  .button.large {
    min-height: 58px;

    padding: 0 30px;

    font-size: 15px;
  }

  .primary,
  .cta {
    background: var(--red);

    color: white;

    border: 2px solid var(--red);

    box-shadow: 0 14px 30px rgba(227, 6, 19, 0.2);
  }

  .primary:hover,
  .cta:hover {
    background: var(--red-dark);

    border-color: var(--red-dark);
  }

  .secondary {
    background: white;

    color: var(--red);

    border: 2px solid var(--red);
  }

  .secondary:hover {
    background: #fff5f5;
  }

  /* =========================================================
        											   HERO
        											========================================================= */

  .hero {
    min-height: auto;
    padding: 50px clamp(32px, 7vw, 96px) 32px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 48px;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(48px, 5vw, 72px);
    line-height: 1;
    letter-spacing: -0.055em;
    color: var(--heading);
  }

  .heroContent {
    min-width: 0;
    width: 100%;
  }

  .eyebrow {
    margin: 0 0 16px;
    color: var(--red);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: clamp(36px, 5vw, 62px);
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--heading);
  }

  .lead {
    margin: 28px 0 0;
    max-width: 680px;
    color: var(--muted);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.6;
  }

  .heroActions {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .heroPortrait {
    min-width: 0;
    width: 100%;
    max-width: 640px;
    margin: 0;
    justify-self: center;
  }

  .heroPortrait img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
  }

  .heroPortrait figcaption {
    display: grid;
    gap: 4px;
    margin-top: 14px;
    text-align: center;
    color: var(--muted);
    font-size: 15px;
  }

  .heroPortrait figcaption strong {
    color: var(--heading);
    font-size: 18px;
  }

  .heroImage,
  .heroProfile,
  .heroCaption,
  .team,
  .teamImage,
  .teamProfile,
  .teamCaption,
  .teamCard,
  .reviews {
    display: none !important;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding: 32px 24px 48px;
    }

    .hero h1 {
      font-size: clamp(42px, 10vw, 64px);
    }

    .heroActions {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      margin-top: 28px;
    }

    .heroActions .button {
      box-sizing: border-box;
      width: 100%;
      text-align: center;
      justify-content: center;
    }

    .products {
      padding-top: 16px;
    }
  }

  /* =========================================================
        											   PRODUCTOS
        											========================================================= */

  .products {
    padding: 40px clamp(24px, 6vw, 88px) 50px;
  }

  .languages {
    padding: 40px clamp(24px, 6vw, 88px);
  }

  .sectionHeader {
    max-width: 880px;
  }

  .productGrid {
    margin-top: 42px;

    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 22px;
  }

  .productCard {
    min-height: 255px;

    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 26px;

    padding: 34px 28px;

    display: flex;

    flex-direction: column;

    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;

    cursor: pointer;
  }

  .productCard:hover {
    transform: translateY(-4px);

    border-color: var(--red);

    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
  }

  .productCard:hover .productIcon {
    transform: scale(1.08);
  }

  .productIcon {
    width: 56px;

    height: 56px;

    margin-bottom: 24px;

    display: block;

    transition: transform 0.25s ease;

    color: var(--red);
  }

  .productCard h3 {
    margin: 0 0 14px;

    font-size: 24px;

    font-weight: 900;

    color: var(--heading);
  }

  .productCard p {
    margin: 0;

    color: var(--muted);

    font-size: 16px;

    line-height: 1.5;

    font-weight: 600;
  }

  .productLink {
    display: inline-block;

    margin-top: auto;

    padding-top: 24px;

    color: var(--red);

    font-weight: 900;

    font-size: 17px;

    text-decoration: none;

    transition: all 0.2s ease;
  }

  .productLink:hover {
    color: var(--red-dark);

    transform: translateX(4px);
  }

  .trust > p {
    margin: 0;

    color: var(--muted);

    font-size: clamp(18px, 2vw, 22px);

    line-height: 1.7;
  }

  /* =========================================================
        											   OFICINA
        											========================================================= */

  /* =========================================
           SECCIÓN OFICINA
        ========================================= */

  .officeSection {
    padding: 0 clamp(24px, 6vw, 88px) 40px;
    background: #f4f5f7;
  }

  .officeLayout .trustBar {
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  /* =========================================
           DISTRIBUCIÓN GENERAL
        ========================================= */

  .officeLayout {
    max-width: 1320px;
    margin: 0 auto;

    display: grid;
    grid-template-columns: minmax(260px, 1fr) minmax(0, 2.5fr);
    gap: 24px;
    align-items: stretch;
  }

  /* =========================================
           TRES TARJETAS DE VENTAJAS
        ========================================= */

  .trustBar {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 16px;

    max-width: none;
    margin: 0;
    padding: 0;

    background: transparent;
    border: none;
    border-radius: 0;
  }

  .trustItem {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    text-align: left;
    gap: 6px;
    min-width: 0;
    position: relative;
    padding: 20px 24px 20px 32px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 16px;
  }

  .trustItem strong {
    color: #172b45;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
  }

  .trustItem span {
    color: var(--muted);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    white-space: normal;
  }

  .trustItem::before {
    content: "";
    position: absolute;
    left: 12px;
    top: 25%;
    height: 50%;
    width: 3px;
    background: var(--red);
    border-radius: 3px;
  }

  /* =========================================
           TARJETA DE OFICINA
        ========================================= */

  .officeCard {
    width: 100%;
    max-width: none;
    margin: 0;

    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 24px;

    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 32px;
    align-items: center;

    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.06);
  }

  /* INFORMACIÓN DE LA OFICINA */

  .officeInfo {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .officeInfo strong {
    font-size: 18px;
  }

  .officeInfo span,
  .officeCard span {
    color: var(--muted);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.35;
  }

  /* =========================================
           MAPA GOOGLE
        ========================================= */

  .mapa {
    margin-top: 0;
    min-width: 0;
  }

  .mapa iframe {
    display: block;
    width: 100%;
    height: 250px;
    border: 0;
    border-radius: 16px;
    box-shadow: none;
  }

  /* =========================================
           BOTÓN CÓMO LLEGAR
        ========================================= */

  .btnMapa {
    width: fit-content;
    margin-top: 8px;
    padding: 12px 22px;

    background: var(--red);
    color: #ffffff;

    border-radius: 10px;
    font-weight: 800;
  }

  .btnMapa:hover {
    background: var(--red-dark);
  }

  /* =========================================
           TABLETS
        ========================================= */

  @media (max-width: 1100px) {
    .officeLayout .trustBar {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: auto;
      align-items: stretch;
      gap: 16px;
    }
    .officeLayout .trustItem {
      height: 100%;
      box-sizing: border-box;
    }

    .trustBar {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: auto;
    }

    .trustItem {
      padding: 18px;
    }
  }

  /* =========================================
           MÓVILES
        ========================================= */

  @media (max-width: 620px) {
    .officeSection {
      padding: 0 16px 24px;
    }

    .officeLayout {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .trustBar {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 12px;
    }

    .trustItem {
      padding: 16px 20px;
    }

    .officeCard {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 20px;
    }

    .mapa iframe {
      height: 240px;
    }
  }

  /* =========================================================
        											   IDIOMAS
        											========================================================= */

  .languageContent {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(280px, 0.45fr);

    gap: clamp(32px, 6vw, 80px);

    align-items: center;
  }

  .languageText {
